---
import site from "../data/site.json";
const { title = "ScribbledToday", description = "A creative space and artist portfolio for words, sounds, stories and moments." } = Astro.props;
const instagram = site.instagram;
const spotify = site.spotify;
const substack = site.substack;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#171714" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500;1,600&family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&display=swap" rel="stylesheet" />
  <style is:global>
    :root{color-scheme:dark;--bg:#171714;--panel:#22221e;--ink:#f2eee5;--muted:#aaa69b;--accent:#d8a875;--line:rgba(242,238,229,.15)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 15% 8%,rgba(122,95,65,.10),transparent 30%),radial-gradient(ellipse at 88% 42%,rgba(122,95,65,.07),transparent 34%),var(--bg);color:var(--ink);font-family:'DM Sans',sans-serif;line-height:1.65;position:relative}body:before{content:'';position:fixed;inset:0;pointer-events:none;z-index:10;opacity:.13;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.86' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E")}a{color:inherit;text-decoration:none}a:hover{color:var(--accent)}.wrap{width:min(1120px,calc(100% - 48px));margin:auto}
    .site-header{min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:22px;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;white-space:nowrap}.brand-mark{width:48px;height:48px;display:block;flex:none}.brand-type{display:flex;flex-direction:column;line-height:1}.brand-name{font:500 29px/.95 'Cormorant Garamond',serif;letter-spacing:-.025em;color:var(--ink)}.brand-name span{color:var(--accent);font-style:italic}.brand-tagline{font-size:8px;letter-spacing:.19em;color:var(--muted);margin-top:7px;text-transform:uppercase}nav{display:flex;gap:24px;flex-wrap:wrap;color:var(--muted);font-size:12px}nav a:hover{color:var(--accent)}
    .eyebrow{color:var(--accent);font-size:10px;letter-spacing:.22em;text-transform:uppercase;font-weight:600}.page-hero{padding:82px 0 54px;max-width:820px}.page-hero h1{font:500 clamp(48px,7vw,82px)/.98 'Cormorant Garamond',serif;letter-spacing:-.035em;margin:16px 0}.page-hero h1 em{color:var(--accent)}.page-hero p{color:var(--muted);font-size:17px;max-width:650px}
    .btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border:1px solid var(--accent);font-size:11px;letter-spacing:.08em;text-transform:uppercase;transition:.2s}.btn.primary{background:var(--accent);color:#211b15}.btn:hover{transform:translateY(-2px);color:inherit}
    .section{padding:56px 0;border-top:1px solid var(--line)}.section-title{font:500 clamp(38px,4.5vw,54px)/1.02 'Cormorant Garamond',serif;margin:8px 0 24px}.muted{color:var(--muted)}.card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.work-card{display:flex;flex-direction:column;justify-content:space-between;min-height:220px;padding:26px;background:var(--panel);border:1px solid var(--line);transition:.2s}.work-card:hover{border-color:var(--accent);transform:translateY(-3px)}.card-meta{display:flex;justify-content:space-between;gap:12px;color:var(--accent);font-size:10px;letter-spacing:.12em;text-transform:uppercase}.work-card h2{font:500 36px/1.08 'Cormorant Garamond',serif;margin:26px 0 8px}.work-card p{font-size:13px;color:var(--muted);margin:0}.empty-note{padding:28px;border:1px dashed var(--line);color:var(--muted);font-size:14px}
    .split{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center}.feature-panel{background:linear-gradient(145deg,#34342d,#1c1c19);border:1px solid var(--line);padding:38px;min-height:270px;display:flex;flex-direction:column;justify-content:end;position:relative;overflow:hidden}.feature-panel:before,.feature-panel:after{content:"";position:absolute;border:1px solid rgba(216,168,117,.35);border-radius:50%;width:260px;height:260px;right:-35px;top:-40px}.feature-panel:after{width:180px;height:180px;right:5px;top:0}.feature-panel strong{position:relative;z-index:1;font:500 30px/1.2 'Playfair Display',serif;max-width:260px}.feature-panel em{color:var(--accent)}
    .enquiry{background:#24231f;border:1px solid var(--line);padding:38px}.enquiry h2{font:500 clamp(30px,4vw,44px)/1.15 'Playfair Display',serif;margin:10px 0}.enquiry p{color:var(--muted);max-width:620px}.enquiry-list{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:24px 0}.enquiry-item{border:1px solid var(--line);padding:15px;font-size:13px}.enquiry-item span{display:block;color:var(--accent);font-size:10px;letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
    .article{max-width:760px;margin:0 auto;padding:45px 0 90px}.article h1{font:500 clamp(46px,6.5vw,72px)/1 'Cormorant Garamond',serif;margin:14px 0}.article .lead{font-size:18px;color:var(--muted)}.article-body{font-size:17px;line-height:1.85}.article-body h2,.article-body h3{font-family:'Playfair Display',serif;font-weight:500}.article-body a{color:var(--accent);text-decoration:underline}.article-body img{max-width:100%;height:auto}
    footer{padding:26px 0;color:var(--muted);font-size:11px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:18px;margin-top:60px}.footer-links{display:flex;gap:16px}
    @media(max-width:760px){.wrap{width:min(100% - 32px,560px)}.site-header{align-items:flex-start;flex-direction:column;padding:18px 0}.brand-mark{width:42px;height:42px}.brand-name{font-size:27px}.site-header nav{gap:14px}.page-hero{padding:62px 0 42px}.card-grid,.split{grid-template-columns:1fr}.enquiry{padding:25px}.enquiry-list{grid-template-columns:1fr}.section{padding:42px 0}footer{flex-direction:column}.footer-links{flex-wrap:wrap}}
  </style>
</head>
<body>
  <div class="wrap">
    <header class="site-header">
      <a class="brand" href="/" aria-label="ScribbledToday home">
        <img class="brand-mark" src="/brand-mark.svg" alt="" width="48" height="48" />
        <span class="brand-type"><span class="brand-name">Scribbled<span>Today</span></span><span class="brand-tagline">{site.tagline}</span></span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/words/">Words</a><a href="/sounds/">Sounds</a><a href="/stories/">Stories</a><a href="/moments/">Moments</a><a href="/portfolio/">Portfolio</a><a href="/work-with-me/">Work with me</a>
      </nav>
    </header>
    <slot />
    <footer><span>© {new Date().getFullYear()} ScribbledToday</span><span>{site.tagline}</span><span class="footer-links"><a href={instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={spotify} target="_blank" rel="noreferrer">Spotify ↗</a><a href={substack} target="_blank" rel="noreferrer">Substack ↗</a></span></footer>
  </div>
</body>
</html>