---
import SiteLayout from "../../layouts/SiteLayout.astro";
const instagram = "https://www.instagram.com/scribbledtoday/";
const email = "hello.scribbledtoday@gmail.com";
---
<SiteLayout title="Work With Me, ScribbledToday" description="Enquiries for commissioned creative work, performances, sound sessions and collaborations.">
  <main>
    <div class="page-hero"><div class="eyebrow">For organisers · Curators · Collaborators</div><h1>Let's create something <em>meaningful together.</em></h1><p>Some creative expressions are meant to be shared, experienced and brought to life together.</p></div>
    <section class="section"><p class="muted intro">Whether you're planning an event, looking for a performance, organising a group experience or exploring a creative collaboration, I'd love to hear what you have in mind.</p>
      <div class="eyebrow">Ways to collaborate</div><h2 class="section-title">What we can explore together</h2>
      <div class="card-grid">
        <article class="work-card"><div><h2>Poetry & Spoken Word</h2><p>Hindi poetry performances, poetry accompanied by handpan and customised creative presentations.</p></div></article>
        <article class="work-card"><div><h2>Music & Performances</h2><p>Singing, handpan performances, musical experiences and bhajan jamming.</p></div></article>
        <article class="work-card"><div><h2>Sound Healing Sessions</h2><p>Group sound healing experiences designed to offer people a chance to pause, relax and reconnect through sound.</p></div></article>
        <article class="work-card"><div><h2>Creative & Theatre Collaborations</h2><p>Acting opportunities, theatre productions, plays, storytelling, playwriting and scripts, along with other creative collaborations.</p></div></article>
      </div>
    </section>
    <section class="section"><div class="enquiry"><div class="eyebrow">Have something in mind?</div><h2>Every idea begins with a conversation.</h2><p>Tell me a little about what you're planning, and let's explore how we can bring it to life.</p><div class="contact-actions"><a class="btn primary" href={`mailto:${email}`}>Send an Email ↗</a><a class="btn" href={instagram} target="_blank" rel="noreferrer">Connect on Instagram ↗</a></div><p class="contact-email"><a href={`mailto:${email}`}>{email}</a></p></div></section>
  </main>
</SiteLayout>
<style>
.intro{font-size:16px;line-height:1.9;max-width:760px;margin-bottom:44px}.contact-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.contact-email{font-size:13px;margin-top:18px}.contact-email a{color:var(--accent)}@media(max-width:600px){.contact-actions .btn{width:100%}}
</style>