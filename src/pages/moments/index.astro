---
import SiteLayout from "../../layouts/SiteLayout.astro";
const entries = Object.entries(import.meta.glob("../../content/work/*.md", { eager: true }))
  .map(([path, mod]) => ({ slug: path.split("/").pop().replace(/\\.md$/, ""), ...mod.frontmatter }))
  .filter((item) => item.category === "moments" && item.status !== "draft")
  .sort((a,b) => String(b.date || "").localeCompare(String(a.date || "")));
---
<SiteLayout title="Moments, ScribbledToday" description="Photographs, experiences, travels and observations.">
  <main><div class="page-hero"><div class="eyebrow">04 / Notice</div><h1>Little things that <em>stay.</em></h1><p>Photographs, travels, encounters and observations, small fragments of life that stayed a little longer.</p></div>
  <section class="section"><div class="eyebrow">Collected along the way</div><h2 class="section-title">Moments</h2>
  <div class="moments-gallery">
    <figure><img src="/images/IMG_1962.jpg" alt="A candid moment while performing with handpan and voice" loading="lazy"/><figcaption>In the middle of a melody</figcaption></figure>
    <figure><img src="/images/16a14b1c-37d2-4647-97d0-16c8b2dcbeb1.JPG" alt="Singing during a festive gathering" loading="lazy"/><figcaption>A song shared with a gathering</figcaption></figure>
    <figure><img src="/images/6BBDF3A1-EED7-472C-B699-252D4D9A9967.JPG" alt="A quiet black and white performance moment with a microphone" loading="lazy"/><figcaption>A quieter moment on stage</figcaption></figure>
    <figure><img src="/images/IMG_5672.jpg" alt="Smiling while playing handpan" loading="lazy"/><figcaption>Finding the rhythm</figcaption></figure>
  </div>
  {entries.length ? <div class="card-grid">{entries.map((entry) => <a class="work-card" href={`/work/${entry.slug}/`}><div class="card-meta"><span>{entry.date || "Moment"}</span><span>↗</span></div><div><h2>{entry.title}</h2><p>{entry.excerpt || "A moment from ScribbledToday."}</p></div></a>)}</div> : <div class="empty-note">This space will gather selected photographs and moments from the creative journey.</div>}</section></main>
</SiteLayout>
<style>
.moments-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:28px 0 36px}.moments-gallery figure{margin:0;position:relative;min-height:260px;overflow:hidden;background:#222;border:1px solid var(--line)}.moments-gallery img{width:100%;height:100%;min-height:260px;max-height:420px;object-fit:cover;display:block;transition:transform .6s}.moments-gallery figure:hover img{transform:scale(1.035)}.moments-gallery figcaption{position:absolute;bottom:0;left:0;right:0;padding:36px 16px 14px;color:#fff;font-size:11px;background:linear-gradient(transparent,rgba(0,0,0,.72))}
@media(max-width:650px){.moments-gallery{grid-template-columns:1fr}.moments-gallery figure,.moments-gallery img{min-height:240px}}
</style>