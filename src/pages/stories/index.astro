---
import SiteLayout from "../../layouts/SiteLayout.astro";
const entries = Object.entries(import.meta.glob("../../content/work/*.md", { eager: true }))
  .map(([path, mod]) => ({ slug: path.split("/").pop().replace(/\.md$/, ""), ...mod.frontmatter }))
  .filter((item) => item.category === "stories" && item.status !== "draft")
  .sort((a,b) => String(b.date || "").localeCompare(String(a.date || "")));
---
<SiteLayout title="Stories, ScribbledToday" description="Theatre, acting, storytelling and live experiences.">
  <main><div class="page-hero"><div class="eyebrow">03 / Perform</div><h1>Stories deserve to be <em>lived.</em></h1><p>Theatre, acting, storytelling and shared experiences, the many ways a story can step out of the page and into a room.</p></div>
  <section class="section"><div class="eyebrow">On stage & beyond</div><h2 class="section-title">Stories and experiences</h2>
  {entries.length ? <div class="card-grid">{entries.map((entry) => <a class="work-card" href={`/work/${entry.slug}/`}><div class="card-meta"><span>{entry.date || "Story"}</span><span>↗</span></div><div><h2>{entry.title}</h2><p>{entry.excerpt || "A story from ScribbledToday."}</p></div></a>)}</div> : <div class="empty-note">Stage moments, storytelling sessions and theatre experiences will be collected here.</div>}</section></main>
</SiteLayout>
