---
import SiteLayout from "../../layouts/SiteLayout.astro";
const entries = Object.entries(import.meta.glob("../../content/work/*.md", { eager: true }))
  .map(([path, mod]) => ({ slug: path.split("/").pop().replace(/\\.md$/, ""), ...mod.frontmatter }))
  .filter((item) => item.featured === true && item.status !== "draft")
  .sort((a,b) => String(b.date || "").localeCompare(String(a.date || "")));
---
<SiteLayout title="Portfolio, ScribbledToday" description="Selected creative projects, performances, sessions and collaborations.">
  <main><div class="page-hero"><div class="eyebrow">Selected work</div><h1>A collection of things brought <em>to life.</em></h1><p>A growing portfolio of creative projects, performances, sessions and collaborations. Only selected work will be featured here.</p></div>
  <section class="section"><div class="eyebrow">Highlights</div><h2 class="section-title">Selected projects & experiences</h2>
  <div class="portfolio-gallery">
    <figure><img src="/images/IMG_1954.jpg" alt="Performing at the VIVAAN Handpan and World Music Festival" loading="lazy"/><figcaption><strong>VIVAAN</strong><span>Handpan & world music</span></figcaption></figure>
    <figure><img src="/images/03b3ca75-c94b-4666-bf2e-a137d31b4f51.JPG" alt="Live singing performance" loading="lazy"/><figcaption><strong>Voice & music</strong><span>Singing and live performance</span></figcaption></figure>
    <figure><img src="/images/IMG_5593.jpg" alt="Instruments arranged for a sound session" loading="lazy"/><figcaption><strong>Sound experiences</strong><span>Handpan and sound sessions</span></figcaption></figure>
  </div>
  {entries.length ? <div class="card-grid">{entries.map((entry) => <a class="work-card" href={`/work/${entry.slug}/`}><div class="card-meta"><span>{entry.category || "Featured"}</span><span>{entry.date || ""}</span></div><div><h2>{entry.title}</h2><p>{entry.excerpt || "A selected project from ScribbledToday."}</p></div></a>)}</div> : <div class="empty-note">Selected performances, creative projects and collaborations will be featured here as the portfolio takes shape.</div>}</section>
  <section class="section"><div class="enquiry"><div class="eyebrow">Have a brief or an invitation?</div><h2>Let's make something meaningful.</h2><p class="muted">If you are organising an event, planning a session or looking for a creative collaborator, I'd be glad to hear what you have in mind.</p><a class="btn primary" href="/work-with-me/">Work with me ↗</a></div></section></main>
</SiteLayout>
<style>
.portfolio-gallery{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;margin:28px 0 36px}.portfolio-gallery figure{margin:0;position:relative;min-height:300px;overflow:hidden;border:1px solid var(--line);background:#222}.portfolio-gallery img{width:100%;height:100%;min-height:300px;object-fit:cover;display:block;transition:transform .6s}.portfolio-gallery figure:hover img{transform:scale(1.035)}.portfolio-gallery figcaption{position:absolute;left:0;right:0;bottom:0;padding:44px 16px 15px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.8))}.portfolio-gallery figcaption strong,.portfolio-gallery figcaption span{display:block}.portfolio-gallery figcaption strong{font:500 26px 'Cormorant Garamond',serif}.portfolio-gallery figcaption span{font-size:10px;letter-spacing:.08em}
@media(max-width:700px){.portfolio-gallery{grid-template-columns:1fr 1fr}.portfolio-gallery figure:first-child{grid-column:span 2}.portfolio-gallery figure{min-height:220px}.portfolio-gallery img{min-height:220px}}
</style>