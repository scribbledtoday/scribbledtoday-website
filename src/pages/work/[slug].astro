---
import SiteLayout from "../../layouts/SiteLayout.astro";
const modules = import.meta.glob("../../content/work/*.md", { eager: true });
export function getStaticPaths() {
  return Object.entries(modules).map(([path, mod]) => ({
    params: { slug: path.split("/").pop().replace(/\.md$/, "") },
    props: { entry: mod }
  }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.frontmatter;
---
<SiteLayout title={`${data.title} — ScribbledToday`} description={data.excerpt || "A piece from ScribbledToday."}>
  <main class="article"><a class="muted" href={data.category === "words" ? "/words/" : data.category === "sounds" ? "/sounds/" : data.category === "stories" ? "/stories/" : "/moments/"}>← Back to {data.category || "work"}</a><div class="eyebrow" style="margin-top:30px">{data.category || "ScribbledToday"} {data.date ? `· ${data.date}` : ""}</div><h1>{data.title}</h1>{data.excerpt && <p class="lead">{data.excerpt}</p>}<div class="article-body"><Content /></div></main>
</SiteLayout>
