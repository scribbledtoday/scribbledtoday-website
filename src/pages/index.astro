---
import SiteLayout from "../layouts/SiteLayout.astro";
const instagram = "https://www.instagram.com/scribbledtoday/";
---
<SiteLayout title="ScribbledToday — Words, Sounds & Stories" description="A creative personal space and artist portfolio for poetry, writing, handpan, performances, storytelling and collaborations.">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">A creative space · An artist portfolio</div>
        <h1>Some things are too alive to stay <em>inside.</em></h1>
        <p>Words, sounds, stories and the moments in between. A home for what I create — and a space to create something together.</p>
        <div class="hero-actions"><a class="btn primary" href="#explore">Explore my work</a><a class="btn" href="/work-with-me/">Work with me</a></div>
      </div>
      <div class="hero-art" aria-label="Abstract artwork representing creative expression">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="hero-art-note"><span>scribbled today</span><strong>A little of life.<br/><em>A lot of expression.</em></strong><small>WORDS · SOUNDS · STORIES</small></div>
      </div>
    </section>
    <section id="explore" class="home-section">
      <div class="section-heading"><div><div class="eyebrow">The many ways I express</div><h2>Explore the scribbles.</h2></div><p>Different forms, one curiosity: to create, experience and share.</p></div>
      <div class="home-grid">
        <a class="home-tile" href="/words/"><span>01 / WRITE</span><strong>Words</strong><small>Poetry · Essays · Reflections</small><i>↗</i></a>
        <a class="home-tile" href="/sounds/"><span>02 / LISTEN</span><strong>Sounds</strong><small>Handpan · Music · Sound journeys</small><i>↗</i></a>
        <a class="home-tile" href="/stories/"><span>03 / PERFORM</span><strong>Stories</strong><small>Theatre · Acting · Storytelling</small><i>↗</i></a>
        <a class="home-tile" href="/moments/"><span>04 / NOTICE</span><strong>Moments</strong><small>Experiences · Photographs · Notes</small><i>↗</i></a>
      </div>
    </section>
    <section class="home-section split-home">
      <div><div class="eyebrow">Selected work & experiences</div><h2>Made to be shared.</h2><p class="home-muted">From a poem that asks to be read twice to a handpan melody shared in a room full of people — this is where creative work finds a home.</p><a class="text-link" href="/portfolio/">Explore the portfolio ↗</a></div>
      <div class="quote-panel"><span>AN ONGOING COLLECTION</span><strong>Not everything needs a stage.<br/><em>But every expression deserves a space.</em></strong></div>
    </section>
    <section class="home-section">
      <div class="enquiry-home">
        <div><div class="eyebrow">For organisers & collaborators</div><h2>Have an idea?<br/><em>Let's make it happen.</em></h2><p>Open to conversations around commissioned creative work, performances, workshops, sound experiences and collaborations.</p><a class="btn primary" href="/work-with-me/">Explore ways to work together ↗</a></div>
        <div class="enquiry-points"><div><span>01 / CREATE</span>Commissioned writing & creative projects</div><div><span>02 / PERFORM</span>Poetry, handpan & performance opportunities</div><div><span>03 / FACILITATE</span>Sound experiences & group sessions</div><div><span>04 / COLLABORATE</span>Events, festivals & creative partnerships</div></div>
      </div>
    </section>
    <section class="home-bottom"><div><div class="eyebrow">Stay connected</div><h2>Follow the thread.</h2><p>New work, small discoveries and moments from the creative process.</p></div><div class="bottom-links"><a href={instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href="https://open.spotify.com/" target="_blank" rel="noreferrer">Spotify ↗</a><a href="https://scribbledtoday.substack.com/" target="_blank" rel="noreferrer">Substack ↗</a></div></section>
  </main>
</SiteLayout>
<style>
.home-hero{padding:112px 0 105px;display:grid;grid-template-columns:1.08fr .92fr;gap:48px;align-items:center}
.hero-copy{position:relative;z-index:1}.hero-copy h1{font:500 clamp(58px,8vw,104px)/.91 'Cormorant Garamond',serif;letter-spacing:-.045em;margin:24px 0 26px;max-width:680px}.hero-copy h1 em,.enquiry-home h2 em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.12em;font-weight:400;letter-spacing:0}.hero-copy p{max-width:500px;color:var(--muted);font-size:16px;line-height:1.9}.hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:32px}
.hero-art{min-height:455px;position:relative;overflow:hidden;border:1px solid rgba(216,168,117,.22);border-radius:48% 48% 5px 5px / 38% 38% 5px 5px;background:radial-gradient(ellipse at 48% 38%,rgba(216,168,117,.29),transparent 36%),radial-gradient(ellipse at 72% 75%,rgba(114,91,69,.28),transparent 45%),linear-gradient(145deg,#37352e,#1a1a17 74%);display:flex;align-items:end;padding:38px;box-shadow:inset 0 0 80px rgba(0,0,0,.22)}
.hero-art:before{content:"";position:absolute;width:76%;height:76%;left:12%;top:9%;border:1px solid rgba(224,190,151,.36);border-radius:52% 48% 61% 39% / 43% 58% 42% 57%;transform:rotate(-24deg);box-shadow:0 0 0 18px rgba(216,168,117,.025),0 0 0 38px rgba(216,168,117,.025)}
.hero-art:after{content:"";position:absolute;width:45%;height:58%;right:10%;top:12%;border:1px solid rgba(224,190,151,.2);border-radius:48% 52% 35% 65% / 60% 38% 62% 40%;transform:rotate(27deg)}
.orbit{position:absolute;border:1px solid rgba(216,168,117,.28);border-radius:50%;width:250px;height:250px;right:-70px;top:70px;transform:rotate(35deg)}.orbit-two{width:170px;height:170px;right:10px;top:115px;border-color:rgba(216,168,117,.18)}
.hero-art-note{position:relative;z-index:1}.hero-art-note span,.hero-art-note small{display:block;color:var(--accent);font-size:10px;letter-spacing:.2em;text-transform:uppercase}.hero-art-note strong{display:block;font:500 42px/1.02 'Cormorant Garamond',serif;margin:17px 0 23px}.hero-art-note em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.15em;font-weight:400}
.home-section{padding:86px 0;border-top:1px solid var(--line);position:relative}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:38px}.section-heading h2,.split-home h2,.home-bottom h2{font:500 clamp(42px,5.5vw,64px)/.98 'Cormorant Garamond',serif;margin:10px 0}.section-heading p,.home-muted,.home-bottom p{color:var(--muted);max-width:400px}.home-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.home-tile{min-height:250px;position:relative;padding:30px;background:linear-gradient(135deg,rgba(45,42,35,.92),rgba(29,29,25,.95));border:1px solid rgba(216,168,117,.16);border-radius:3px 42px 3px 42px;display:flex;flex-direction:column;justify-content:end;overflow:hidden;transition:transform .35s,border-color .35s}.home-tile:nth-child(2),.home-tile:nth-child(3){border-radius:42px 3px 42px 3px}
.home-tile:before{content:"";position:absolute;width:220px;height:220px;border:1px solid rgba(216,168,117,.2);border-radius:44% 56% 62% 38% / 52% 40% 60% 48%;right:-62px;top:-90px;transform:rotate(28deg);transition:transform .5s}.home-tile:after{content:"";position:absolute;width:150px;height:150px;border:1px solid rgba(216,168,117,.12);border-radius:50%;right:-26px;top:-54px}.home-tile:hover{border-color:var(--accent);transform:translateY(-5px);color:var(--ink)}.home-tile:hover:before{transform:rotate(65deg) scale(1.08)}
.home-tile span,.home-tile small{font-size:10px;letter-spacing:.15em;color:var(--accent);text-transform:uppercase}.home-tile strong{font:500 48px/.95 'Cormorant Garamond',serif;margin:24px 0 7px}.home-tile small{color:var(--muted);letter-spacing:.06em;text-transform:none}.home-tile i{position:absolute;right:28px;bottom:30px;font-style:normal;color:var(--accent)}
.split-home{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.text-link{display:inline-block;margin-top:18px;color:var(--accent);font-size:12px}.quote-panel{min-height:290px;background:radial-gradient(ellipse at 85% 20%,rgba(216,168,117,.13),transparent 48%),linear-gradient(145deg,#34342d,#1d1d19);border:1px solid var(--line);border-radius:46% 4px 46% 4px / 12% 4px 12% 4px;padding:42px;display:flex;flex-direction:column;justify-content:end}.quote-panel span{color:var(--accent);font-size:10px;letter-spacing:.18em}.quote-panel strong{font:500 34px/1.15 'Cormorant Garamond',serif;margin-top:20px}.quote-panel em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.12em;font-weight:400}
.enquiry-home{padding:48px;background:linear-gradient(130deg,rgba(44,42,35,.96),rgba(30,30,26,.96));border:1px solid var(--line);border-radius:4px 54px 4px 54px;display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center;position:relative;overflow:hidden}.enquiry-home:after{content:"";position:absolute;width:260px;height:260px;border:1px solid rgba(216,168,117,.12);border-radius:50%;right:-110px;top:-125px;box-shadow:0 0 0 24px rgba(216,168,117,.025),0 0 0 48px rgba(216,168,117,.02);pointer-events:none}.enquiry-home h2{font:500 clamp(42px,5vw,60px)/.98 'Cormorant Garamond',serif;margin:14px 0}.enquiry-home p{color:var(--muted);max-width:470px;font-size:14px}.enquiry-home .btn{margin-top:16px}.enquiry-points{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative;z-index:1}.enquiry-points div{padding:17px 15px;border:1px solid var(--line);border-radius:2px 18px 2px 18px;font-size:12px;background:rgba(15,15,13,.16)}.enquiry-points span{display:block;color:var(--accent);font-size:9px;letter-spacing:.12em;margin-bottom:6px}
.home-bottom{padding:72px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;align-items:center}.home-bottom h2{margin-bottom:0}.bottom-links{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--accent)}
@media(max-width:760px){.home-hero{grid-template-columns:1fr;padding:68px 0;gap:32px}.hero-copy h1{font-size:clamp(58px,15vw,82px)}.hero-art{min-height:340px;width:100%;border-radius:45% 45% 4px 4px / 28% 28% 4px 4px}.home-grid,.split-home,.enquiry-home{grid-template-columns:1fr}.section-heading,.home-bottom{align-items:flex-start;flex-direction:column}.home-section{padding:58px 0}.enquiry-home{padding:28px 24px;border-radius:4px 34px 4px 34px}.enquiry-points{grid-template-columns:1fr 1fr}.home-tile{min-height:220px}}
</style>