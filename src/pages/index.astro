---
import SiteLayout from "../layouts/SiteLayout.astro";
import site from "../data/site.json";
const instagram = site.instagram;
const spotify = site.spotify;
const substack = site.substack;
const email = site.email;
---
<SiteLayout title="ScribbledToday, Words, Sounds & Stories" description="A creative personal space for poetry, writing, handpan, performances, storytelling and collaborations.">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">{site.home_eyebrow}</div>
        <h1>{site.home_headline}</h1>
        <p>{site.home_intro}</p>
        <div class="hero-actions"><a class="btn primary" href="#explore">Explore my work</a><a class="btn" href="/work-with-me/">Work with me</a></div>
      </div>
      <div class="hero-art" aria-label="Abstract artwork representing creative expression">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="hero-art-note"><span>scribbled today</span><strong>A little of life.<br/><em>A lot of expression.</em></strong><small>WORDS · SOUNDS · STORIES</small><p class="hero-whisper">where a thought finds a word,<br/>a feeling finds a sound.</p></div>
      </div>
    </section>
    <div class="poetry-thread"><span class="thread-mark">✳</span><p>A word becomes a poem. A breath becomes a melody.<br/>A moment becomes a story.</p><span class="thread-mark">✳</span></div>

    <section class="home-section about-home">
      <div class="about-copy"><div class="eyebrow">Beyond the work</div><h2>{site.bio_heading}</h2><p>{site.bio_text}</p></div>
      {site.profile_image && <div class="about-photo"><img src={site.profile_image} alt="Portrait" /></div>}
    </section>
    <section class="home-gallery-section" aria-label="A glimpse into Words, Sounds and Stories">
      <div class="section-heading"><div><div class="eyebrow">A glimpse into my creative world</div><h2>A few things I've brought to life.</h2></div><p>Explore the expressions behind the words, sounds and stories.</p></div>
      <div class="home-photo-grid">
        <a class="home-photo home-photo-words" href="/words/"><img src="/images/IMG_1962.jpg" alt="Poetry performed with handpan"/><span><strong>Words</strong><small>Thoughts, feelings and stories finding their way into words.</small></span></a>
        <a class="home-photo" href="/sounds/"><img src="/images/IMG_1954.jpg" alt="Handpan performance at VIVAAN Handpan and World Music Festival"/><span><strong>Sounds</strong><small>Melodies, rhythms and moments that are meant to be felt.</small></span></a>
        <a class="home-photo" href="/sounds/"><img src="/images/03b3ca75-c94b-4666-bf2e-a137d31b4f51.JPG" alt="Singing during a live performance"/><span><strong>Sounds</strong><small>Singing and songwriting in Hindi.</small></span></a>
        <a class="home-photo" href="/stories/"><img src="/images/Comedian%20Under%20the%20Spotlight.png" alt="Performing on a small theatre stage"/><span><strong>Stories</strong><small>Characters, expressions and stories brought to life.</small></span></a>
        <a class="home-photo" href="/sounds/"><img src="/images/IMG_5593.jpg" alt="Instruments arranged for a sound session"/><span><strong>Sounds</strong><small>Making space to pause and listen.</small></span></a>
      </div>
    </section>
    <section class="featured-poem" aria-labelledby="featured-poem-title">
      <div class="poem-kicker">A few lines from my notebook · Hindi poetry</div>
      <h2 id="featured-poem-title" lang="hi">उसने कहा तुमसे न हो पाएगा,<br/>और लौट के वापस यहीं आएगा।</h2>
      <p lang="hi">मैं मुस्कुराया, और बढ़ चला आगे,<br/>पर न किसी को बताने, और न उसे जताने।</p>
      <span class="poem-flourish" aria-hidden="true">✳</span>
    </section>
    <section id="explore" class="home-section">
      <div class="section-heading"><div><div class="eyebrow">The many ways I express</div><h2>Explore the scribbles.</h2></div><p>Different forms, one curiosity: to create, experience and share.</p></div>
      <div class="home-grid">
        <a class="home-tile" href="/words/"><strong>Words</strong><small>Poetry · Essays · Reflections</small><i>↗</i></a>
        <a class="home-tile" href="/sounds/"><strong>Sounds</strong><small>Singing · Handpan · Sound journeys</small><i>↗</i></a>
        <a class="home-tile" href="/stories/"><strong>Stories</strong><small>Theatre · Acting · Storytelling</small><i>↗</i></a>
      </div>
    </section>
    <section class="home-section">
      <div class="enquiry-home">
        <div><div class="eyebrow">For organisers & collaborators</div><h2>Have an idea?<br/><em>Let's make it happen.</em></h2><p>Open to conversations around commissioned creative work, performances, workshops, sound experiences and collaborations.</p><a class="btn primary" href="/work-with-me/">Explore ways to work together ↗</a></div>
        <div class="enquiry-points"><div>Commissioned writing, acting projects, theatre & creative initiatives</div><div>Poetry, handpan & performance opportunities</div><div>Sound experiences & group sessions</div><div>Events, festivals & creative partnerships</div></div>
      </div>
    </section>
    <section class="home-bottom"><div><div class="eyebrow">Stay connected</div><h2>Follow the thread.</h2><p>New work, small discoveries and glimpses from the creative process.</p></div><div class="bottom-links"><a href={instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={spotify} target="_blank" rel="noreferrer">Spotify ↗</a><a href={substack} target="_blank" rel="noreferrer">Substack ↗</a><a href={`mailto:${email}`}>Get in touch ↗</a></div></section>
  </main>
</SiteLayout>
<style>
.home-gallery-section{padding:78px 0;border-top:1px solid var(--line)}.home-photo-grid{display:grid;grid-template-columns:1.15fr 1fr 1fr;grid-template-rows:220px 220px;gap:14px}.home-photo{position:relative;overflow:hidden;min-height:0;border:1px solid var(--line);background:#222}.home-photo-words{grid-row:span 2}.home-photo img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}.home-photo:hover img{transform:scale(1.04)}.home-photo span{position:absolute;left:0;right:0;bottom:0;padding:42px 16px 15px;background:linear-gradient(transparent,rgba(0,0,0,.82));color:#fff}.home-photo strong{display:block;font:500 27px/1.1 "Cormorant Garamond",serif}.home-photo small{display:block;font-size:11px;line-height:1.5;margin-top:4px;color:#eee}.about-home{display:grid;grid-template-columns:minmax(0,1fr) minmax(240px,.7fr);gap:48px;align-items:center}.about-copy h2{font:500 clamp(42px,5.5vw,64px)/.98 'Cormorant Garamond',serif;margin:10px 0 18px}.about-copy p{color:var(--muted);font-size:15px;line-height:1.9;max-width:700px;white-space:pre-line}.about-photo{max-width:360px;justify-self:end}.about-photo img{display:block;width:100%;max-height:420px;object-fit:cover;border-radius:46% 46% 4px 4px / 28% 28% 4px 4px;border:1px solid rgba(216,168,117,.28)}
.home-hero{padding:112px 0 105px;display:grid;grid-template-columns:1.08fr .92fr;gap:48px;align-items:center}
.hero-copy{position:relative;z-index:1}.hero-copy h1{font:500 clamp(58px,8vw,104px)/.91 'Cormorant Garamond',serif;letter-spacing:-.045em;margin:24px 0 26px;max-width:680px}.hero-copy h1 em,.enquiry-home h2 em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.12em;font-weight:400;letter-spacing:0}.hero-copy p{max-width:500px;color:var(--muted);font-size:16px;line-height:1.9}.hero-actions{display:flex;gap:13px;flex-wrap:wrap;margin-top:32px}
.hero-art{min-height:455px;position:relative;overflow:hidden;border:1px solid rgba(216,168,117,.22);border-radius:48% 48% 5px 5px / 38% 38% 5px 5px;background:radial-gradient(ellipse at 48% 38%,rgba(216,168,117,.29),transparent 36%),radial-gradient(ellipse at 72% 75%,rgba(114,91,69,.28),transparent 45%),linear-gradient(145deg,#37352e,#1a1a17 74%);display:flex;align-items:end;padding:38px;box-shadow:inset 0 0 80px rgba(0,0,0,.22)}
.hero-art:before{content:"";position:absolute;width:76%;height:76%;left:12%;top:9%;border:1px solid rgba(224,190,151,.36);border-radius:52% 48% 61% 39% / 43% 58% 42% 57%;transform:rotate(-24deg);box-shadow:0 0 0 18px rgba(216,168,117,.025),0 0 0 38px rgba(216,168,117,.025)}
.hero-art:after{content:"";position:absolute;width:45%;height:58%;right:10%;top:12%;border:1px solid rgba(224,190,151,.2);border-radius:48% 52% 35% 65% / 60% 38% 62% 40%;transform:rotate(27deg)}
.orbit{position:absolute;border:1px solid rgba(216,168,117,.28);border-radius:50%;width:250px;height:250px;right:-70px;top:70px;transform:rotate(35deg)}.orbit-two{width:170px;height:170px;right:10px;top:115px;border-color:rgba(216,168,117,.18)}
.hero-art-note{position:relative;z-index:1}.hero-art-note span,.hero-art-note small{display:block;color:var(--accent);font-size:10px;letter-spacing:.2em;text-transform:uppercase}.hero-art-note strong{display:block;font:500 42px/1.02 'Cormorant Garamond',serif;margin:17px 0 23px}.hero-art-note em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.15em;font-weight:400}
.featured-poem{position:relative;text-align:center;padding:76px 24px 82px;margin:0 auto;max-width:900px;border-top:1px solid rgba(216,168,117,.14);border-bottom:1px solid rgba(216,168,117,.14);overflow:hidden}.poem-kicker{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--accent);margin-bottom:28px}.featured-poem h2,.featured-poem p{font-family:'Noto Serif Devanagari',serif;font-size:clamp(20px,2.5vw,27px);font-weight:400;line-height:1.85;letter-spacing:0;margin:0;color:var(--ink)}.featured-poem h2{margin:0 0 10px}.featured-poem p{color:var(--ink)}.poem-flourish{display:block;color:var(--accent);font-size:15px;margin-top:26px;opacity:.75}
.home-section{padding:86px 0;border-top:1px solid var(--line);position:relative}.poetry-thread{display:flex;align-items:center;justify-content:center;gap:22px;padding:26px 12px 42px;text-align:center;color:var(--accent);border-top:1px solid rgba(216,168,117,.12)}.poetry-thread p{font:400 clamp(23px,3vw,34px)/1.15 Caveat,cursive;margin:0;max-width:760px}.thread-mark{font-size:13px;opacity:.65}.hero-whisper{font:400 22px/1.12 Caveat,cursive;color:rgba(242,238,229,.78);margin:23px 0 0;letter-spacing:.02em}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:38px}.section-heading h2,.split-home h2,.home-bottom h2{font:500 clamp(42px,5.5vw,64px)/.98 'Cormorant Garamond',serif;margin:10px 0}.section-heading p,.home-muted,.home-bottom p{color:var(--muted);max-width:400px}.home-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.home-tile{min-height:250px;position:relative;padding:30px;background:linear-gradient(135deg,rgba(45,42,35,.92),rgba(29,29,25,.95));border:1px solid rgba(216,168,117,.16);border-radius:3px 42px 3px 42px;display:flex;flex-direction:column;justify-content:end;overflow:hidden;transition:transform .35s,border-color .35s}.home-tile:nth-child(2),.home-tile:nth-child(3){border-radius:42px 3px 42px 3px}
.home-tile:before{content:"";position:absolute;width:220px;height:220px;border:1px solid rgba(216,168,117,.2);border-radius:44% 56% 62% 38% / 52% 40% 60% 48%;right:-62px;top:-90px;transform:rotate(28deg);transition:transform .5s}.home-tile:after{content:"";position:absolute;width:150px;height:150px;border:1px solid rgba(216,168,117,.12);border-radius:50%;right:-26px;top:-54px}.home-tile:hover{border-color:var(--accent);transform:translateY(-5px);color:var(--ink)}.home-tile:hover:before{transform:rotate(65deg) scale(1.08)}
.home-tile span,.home-tile small{font-size:10px;letter-spacing:.15em;color:var(--accent);text-transform:uppercase}.home-tile strong{font:500 48px/.95 'Cormorant Garamond',serif;margin:24px 0 7px}.home-tile small{color:var(--muted);letter-spacing:.06em;text-transform:none}.home-tile i{position:absolute;right:28px;bottom:30px;font-style:normal;color:var(--accent)}
.split-home{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.text-link{display:inline-block;margin-top:18px;color:var(--accent);font-size:12px}.quote-panel{min-height:290px;background:radial-gradient(ellipse at 85% 20%,rgba(216,168,117,.13),transparent 48%),linear-gradient(145deg,#34342d,#1d1d19);border:1px solid var(--line);border-radius:46% 4px 46% 4px / 12% 4px 12% 4px;padding:42px;display:flex;flex-direction:column;justify-content:end}.quote-panel span{color:var(--accent);font-size:10px;letter-spacing:.18em}.quote-panel strong{font:500 34px/1.15 'Cormorant Garamond',serif;margin-top:20px}.quote-panel em{font-family:'Caveat',cursive;color:var(--accent);font-size:1.12em;font-weight:400}
.enquiry-home{padding:48px;background:linear-gradient(130deg,rgba(44,42,35,.96),rgba(30,30,26,.96));border:1px solid var(--line);border-radius:4px 54px 4px 54px;display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center;position:relative;overflow:hidden}.enquiry-home:after{content:"";position:absolute;width:260px;height:260px;border:1px solid rgba(216,168,117,.12);border-radius:50%;right:-110px;top:-125px;box-shadow:0 0 0 24px rgba(216,168,117,.025),0 0 0 48px rgba(216,168,117,.02);pointer-events:none}.enquiry-home h2{font:500 clamp(42px,5vw,60px)/.98 'Cormorant Garamond',serif;margin:14px 0}.enquiry-home p{color:var(--muted);max-width:470px;font-size:14px}.enquiry-home .btn{margin-top:16px}.enquiry-points{display:grid;grid-template-columns:1fr 1fr;gap:12px;position:relative;z-index:1}.enquiry-points div{padding:17px 15px;border:1px solid var(--line);border-radius:2px 18px 2px 18px;font-size:12px;background:rgba(15,15,13,.16)}.enquiry-points span{display:block;color:var(--accent);font-size:9px;letter-spacing:.12em;margin-bottom:6px}
.home-bottom{padding:72px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;align-items:center}.home-bottom h2{margin-bottom:0}.bottom-links{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--accent)}
@media(max-width:760px){.home-hero{grid-template-columns:1fr;padding:68px 0;gap:32px}.hero-copy h1{font-size:clamp(58px,15vw,82px)}.hero-art{min-height:340px;width:100%;border-radius:45% 45% 4px 4px / 28% 28% 4px 4px}.home-grid,.split-home,.enquiry-home,.about-home{grid-template-columns:1fr}.home-photo-grid{grid-template-columns:1fr 1fr;grid-template-rows:220px 180px 180px}.home-photo-words{grid-column:span 2;grid-row:auto}.home-gallery-section{padding:58px 0}.about-photo{justify-self:start;width:min(100%,320px)}.section-heading,.home-bottom{align-items:flex-start;flex-direction:column}.home-section{padding:58px 0}.poetry-thread{padding:24px 4px 32px;gap:12px}.enquiry-home{padding:28px 24px;border-radius:4px 34px 4px 34px}.enquiry-points{grid-template-columns:1fr 1fr}.home-tile{min-height:220px}}
</style>