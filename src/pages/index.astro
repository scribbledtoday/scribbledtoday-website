---
import SiteLayout from "../layouts/SiteLayout.astro";
const instagram = "https://www.instagram.com/scribbledtoday/";
---
<SiteLayout title="ScribbledToday — Words, Sounds & Stories" description="A creative personal space and artist portfolio for poetry, writing, handpan, performances, storytelling and collaborations.">
  <main>
    <section class="home-hero">
      <div class="hero-copy">
        <div class="eyebrow">A creative space · An artist portfolio</div>
        <h1>Some things are too alive to stay <em>inside.</em></h1>
        <p>Words, sounds, stories and the moments in between. A home for what I create — and a space to create something together.</p>
        <div class="hero-actions"><a class="btn primary" href="#explore">Explore my work</a><a class="btn" href="/work-with-me/">Work with me</a></div>
      </div>
      <div class="hero-art" aria-label="Abstract artwork representing creative expression">
        <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
        <div class="hero-art-note"><span>scribbled today</span><strong>A little of life.<br/><em>A lot of expression.</em></strong><small>WORDS · SOUNDS · STORIES</small></div>
      </div>
    </section>
    <section id="explore" class="home-section">
      <div class="section-heading"><div><div class="eyebrow">The many ways I express</div><h2>Explore the scribbles.</h2></div><p>Different forms, one curiosity: to create, experience and share.</p></div>
      <div class="home-grid">
        <a class="home-tile" href="/words/"><span>01 / WRITE</span><strong>Words</strong><small>Poetry · Essays · Reflections</small><i>↗</i></a>
        <a class="home-tile" href="/sounds/"><span>02 / LISTEN</span><strong>Sounds</strong><small>Handpan · Music · Sound journeys</small><i>↗</i></a>
        <a class="home-tile" href="/stories/"><span>03 / PERFORM</span><strong>Stories</strong><small>Theatre · Acting · Storytelling</small><i>↗</i></a>
        <a class="home-tile" href="/moments/"><span>04 / NOTICE</span><strong>Moments</strong><small>Experiences · Photographs · Notes</small><i>↗</i></a>
      </div>
    </section>
    <section class="home-section split-home">
      <div><div class="eyebrow">Selected work & experiences</div><h2>Made to be shared.</h2><p class="home-muted">From a poem that asks to be read twice to a handpan melody shared in a room full of people — this is where creative work finds a home.</p><a class="text-link" href="/portfolio/">Explore the portfolio ↗</a></div>
      <div class="quote-panel"><span>AN ONGOING COLLECTION</span><strong>Not everything needs a stage.<br/><em>But every expression deserves a space.</em></strong></div>
    </section>
    <section class="home-section">
      <div class="enquiry-home">
        <div><div class="eyebrow">For organisers & collaborators</div><h2>Have an idea?<br/><em>Let's make it happen.</em></h2><p>Open to conversations around commissioned creative work, performances, workshops, sound experiences and collaborations.</p><a class="btn primary" href="/work-with-me/">Explore ways to work together ↗</a></div>
        <div class="enquiry-points"><div><span>01 / CREATE</span>Commissioned writing & creative projects</div><div><span>02 / PERFORM</span>Poetry, handpan & performance opportunities</div><div><span>03 / FACILITATE</span>Sound experiences & group sessions</div><div><span>04 / COLLABORATE</span>Events, festivals & creative partnerships</div></div>
      </div>
    </section>
    <section class="home-bottom"><div><div class="eyebrow">Stay connected</div><h2>Follow the thread.</h2><p>New work, small discoveries and moments from the creative process.</p></div><div class="bottom-links"><a href={instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href="https://open.spotify.com/" target="_blank" rel="noreferrer">Spotify ↗</a><a href="https://scribbledtoday.substack.com/" target="_blank" rel="noreferrer">Substack ↗</a></div></section>
  </main>
</SiteLayout>
<style>
.home-hero{padding:100px 0 92px;display:grid;grid-template-columns:1.1fr .9fr;gap:58px;align-items:center}.hero-copy h1{font:500 clamp(48px,7vw,86px)/1.04 'Playfair Display',serif;letter-spacing:-.045em;margin:20px 0}.hero-copy h1 em,.enquiry-home h2 em{color:var(--accent);font-weight:500}.hero-copy p{max-width:520px;color:var(--muted);font-size:17px}.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}
.hero-art{min-height:410px;position:relative;overflow:hidden;border:1px solid var(--line);background:radial-gradient(ellipse at 68% 32%,rgba(216,168,117,.25),transparent 42%),linear-gradient(145deg,#35352e,#1b1b18 72%);display:flex;align-items:end;padding:30px}.orbit{position:absolute;border:1px solid rgba(216,168,117,.35);border-radius:50%;width:310px;height:310px;right:-40px;top:20px}.orbit-two{width:220px;height:220px;right:5px;top:65px;border-color:rgba(216,168,117,.2)}.hero-art-note{position:relative;z-index:1}.hero-art-note span,.hero-art-note small{display:block;color:var(--accent);font-size:10px;letter-spacing:.2em;text-transform:uppercase}.hero-art-note strong{display:block;font:500 34px/1.2 'Playfair Display',serif;margin:15px 0 20px}.hero-art-note em{color:var(--accent)}
.home-section{padding:72px 0;border-top:1px solid var(--line)}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:32px}.section-heading h2,.split-home h2,.home-bottom h2{font:500 clamp(34px,5vw,52px)/1.12 'Playfair Display',serif;margin:8px 0}.section-heading p,.home-muted,.home-bottom p{color:var(--muted);max-width:400px}.home-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.home-tile{min-height:235px;position:relative;padding:25px;background:#24231f;border:1px solid var(--line);display:flex;flex-direction:column;justify-content:end;overflow:hidden;transition:.2s}.home-tile:before{content:"";position:absolute;width:210px;height:210px;border:1px solid rgba(216,168,117,.18);border-radius:50%;right:-50px;top:-75px}.home-tile:hover{border-color:var(--accent);transform:translateY(-3px);color:var(--ink)}.home-tile span,.home-tile small{font-size:10px;letter-spacing:.15em;color:var(--accent);text-transform:uppercase}.home-tile strong{font:500 36px 'Playfair Display',serif;margin:22px 0 3px}.home-tile small{color:var(--muted);letter-spacing:.06em;text-transform:none}.home-tile i{position:absolute;right:24px;bottom:26px;font-style:normal;color:var(--accent)}
.split-home{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}.text-link{display:inline-block;margin-top:15px;color:var(--accent);font-size:12px}.quote-panel{min-height:250px;background:linear-gradient(145deg,#34342d,#1d1d19);border:1px solid var(--line);padding:30px;display:flex;flex-direction:column;justify-content:end}.quote-panel span{color:var(--accent);font-size:10px;letter-spacing:.18em}.quote-panel strong{font:500 26px/1.35 'Playfair Display',serif;margin-top:20px}.quote-panel em{color:var(--accent)}
.enquiry-home{padding:42px;background:#24231f;border:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}.enquiry-home h2{font:500 clamp(34px,4vw,48px)/1.12 'Playfair Display',serif;margin:10px 0}.enquiry-home p{color:var(--muted);max-width:470px;font-size:14px}.enquiry-home .btn{margin-top:12px}.enquiry-points{display:grid;grid-template-columns:1fr 1fr;gap:10px}.enquiry-points div{padding:15px;border:1px solid var(--line);font-size:12px}.enquiry-points span{display:block;color:var(--accent);font-size:9px;letter-spacing:.12em;margin-bottom:5px}
.home-bottom{padding:60px 0;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:30px;align-items:center}.home-bottom h2{margin-bottom:0}.bottom-links{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--accent)}
@media(max-width:760px){.home-hero{grid-template-columns:1fr;padding:65px 0;gap:28px}.hero-art{min-height:290px}.home-grid,.split-home,.enquiry-home{grid-template-columns:1fr}.section-heading,.home-bottom{align-items:flex-start;flex-direction:column}.home-section{padding:50px 0}.enquiry-home{padding:25px}.enquiry-points{grid-template-columns:1fr}}
</style>